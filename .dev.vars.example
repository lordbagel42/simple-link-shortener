# Copy to `.dev.vars` for local development. `.dev.vars` is gitignored.
BETTER_AUTH_SECRET="local-development-secret-change-me-32chars"
VISITOR_HASH_SALT="local-dev-salt"
APP_URL="http://localhost:5173"
SHORT_URL="http://localhost:5173/l"
SHORT_HOST=""
SHORT_PREFIX="/l"
SIGNUP_MODE="open"

