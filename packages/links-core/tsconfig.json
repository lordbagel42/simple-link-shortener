{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		// Workers globals: D1Database, KVNamespace, AnalyticsEngineDataset, and the
		// fetch/Request/Response family the redirect path is written against.
		"types": ["@cloudflare/workers-types"],
		"outDir": "dist",
		"rootDir": "src",
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		// Matches the app's tsconfig. These files were written against plain
		// `strict`; turning on extra checks here would only be churn at move time.
		"strict": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true
	},
	"include": ["src/**/*.ts"]
}
