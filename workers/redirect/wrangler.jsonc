{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "links-redirect",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-01",
	// Deliberately NOT `nodejs_compat`: nothing on this path touches a `node:`
	// builtin, and leaving it off keeps the isolate as small as it can be.
	"compatibility_flags": [],

	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true
		}
	},

	// NO `placement` block on purpose. Smart Placement would move this Worker
	// next to D1, which is exactly wrong here — the redirect only needs an
	// edge-cached KV read, and the D1 write is deferred past the response. This
	// Worker must run as close to the visitor as possible.

	"routes": [
		{ "pattern": "link.raygen.dev", "custom_domain": true },
		{ "pattern": "raygen.dev/l/*", "zone_name": "raygen.dev" }
	],

	"workers_dev": false,
	"preview_urls": false,

	"vars": {
		// Serves slugs at its root. The apex is not listed: it only answers under
		// SHORT_PREFIX, so the rest of raygen.dev is left alone.
		"SHORT_HOSTS": "link.raygen.dev",
		"SHORT_PREFIX": "/l",
		// Where `link.raygen.dev/` (no slug) sends people.
		"APP_URL": "https://links.raygen.dev"
	},

	// Same D1 and KV as the dashboard Worker — one set of links, two readers.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "link-shortener",
			"database_id": "f4f5627e-0940-44d5-9406-ff54a7e28ce1",
			"migrations_dir": "../../drizzle"
		}
	],

	"kv_namespaces": [
		{
			"binding": "LINKS",
			"id": "5fd8fb0f9d8f40c89c13110e5fb41f87"
		}
	],

	"analytics_engine_datasets": [
		{
			"binding": "CLICKS_AE",
			"dataset": "CLICKS_AE"
		}
	]
}
